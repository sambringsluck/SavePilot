{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SavePilot",
  "version": "1.2.0-preview.4",
  "identifier": "app.savepilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SavePilot",
        "width": 1060,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 SavePilot contributors",
    "shortDescription": "Local-first intelligent file organization",
    "longDescription": "SavePilot understands file contents and your folder structure, then proposes a destination and filename before any move.",
    "externalBin": ["binaries/savepilot-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
